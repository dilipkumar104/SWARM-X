<?xml version="1.0"?>
<!--
  SWARM-X Robot URDF
  ==================
  Physical dimensions (4-wheel differential drive):

    Body     : 25 cm long × 20 cm wide × 8 cm tall
    Wheels   : 6.5 cm radius, 2.5 cm wide
    Track    : 20 cm (matches TRACK_WIDTH in motor_controller.py)
    Wheelbase: 18 cm
    Lidar    : mounted on top-centre, 5 cm above body
    HC-SR04  : mounted on front face, body-centre height

  Frames published:
    base_footprint  (on the ground, origin)
    base_link       (centre of robot body)
    laser           (Lidar scan frame)
    ultrasonic_link (HC-SR04 frame)
    {l,r}_{f,r}_wheel_link
-->
<robot name="swarmx_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  MATERIALS                                                  -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.4 0.9 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  BASE FOOTPRINT (ground-level origin)                       -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <!-- base_link is 8cm above ground (wheel radius = 6.5 cm, body z = body/2) -->
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  MAIN BODY                                                  -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.20 0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.20 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <!-- Solid box inertia: m/12*(y²+z²), m/12*(x²+z²), m/12*(x²+y²) -->
      <inertia ixx="0.0053" ixy="0" ixz="0"
               iyy="0.0088" iyz="0"
               izz="0.0120"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  WHEELS  (left-front, right-front, left-rear, right-rear)  -->
  <!-- ═══════════════════════════════════════════════════════════ -->

  <!-- Wheel macro -->
  <xacro:macro name="wheel" params="name x_pos y_pos">

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.025"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.025"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <!-- Cylinder: ixx=iyy = m(3r²+h²)/12, izz = mr²/2 -->
        <inertia ixx="0.00021" ixy="0" ixz="0"
                 iyy="0.00021" iyz="0"
                 izz="0.00032"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_link"/>
      <origin xyz="${x_pos} ${y_pos} -0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

  </xacro:macro>

  <xacro:wheel name="lf_wheel" x_pos=" 0.09" y_pos=" 0.1125"/>
  <xacro:wheel name="rf_wheel" x_pos=" 0.09" y_pos="-0.1125"/>
  <xacro:wheel name="lr_wheel" x_pos="-0.09" y_pos=" 0.1125"/>
  <xacro:wheel name="rr_wheel" x_pos="-0.09" y_pos="-0.1125"/>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  LIDAR (RPLidar A1/A2)                                     -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.18"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <!-- Top-centre of body, 3 cm above body top surface -->
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!--  HC-SR04 ULTRASONIC                                        -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <link name="ultrasonic_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.020 0.015"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.020 0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="ultrasonic_link"/>
    <!-- Front face, body centre height -->
    <origin xyz="0.125 0 0" rpy="0 0 0"/>
  </joint>

</robot>
